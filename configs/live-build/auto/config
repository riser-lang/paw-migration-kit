#!/bin/sh
set -eu
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --mirror-bootstrap 'https://snapshot.debian.org/archive/debian/20261101T000000Z' \
  --mirror-chroot 'https://snapshot.debian.org/archive/debian/20261101T000000Z' \
  --mirror-binary 'https://snapshot.debian.org/archive/debian/20261101T000000Z' \
  --archive-areas 'main non-free-firmware' \
  --security false \
  --initsystem systemd \
  --binary-images iso-hybrid \
  --debian-installer false \
  --apt-recommends false \
  --apt-options '--yes -o Acquire::Check-Valid-Until=false' \
  --bootappend-live 'boot=live components locales=zh_CN.UTF-8 keyboard-layouts=us hostname=paw-live username=paw console=tty1 console=ttyS0,115200n8' \
  --iso-application 'PAW Migration Live' \
  --iso-publisher 'PAW Migration Preparation' \
  --iso-volume 'PAW-LIVE'
