[Unit]
Description=PAW text console menu
After=paw-preflight.service
Wants=paw-preflight.service
Conflicts=getty@tty1.service

[Service]
Type=idle
EnvironmentFile=-/etc/paw-migration.env
ExecStart=/opt/paw-migration/scripts/paw-console-menu.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
