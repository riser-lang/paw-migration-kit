[Unit]
Description=PAW CJK final-authorization panel render probe (test only)
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service getty@tty1.service paw-console-font.service
ConditionKernelCommandLine=paw.final=1
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=PAW_ROOT=/opt/paw-migration
ExecStart=/opt/paw-migration/paw-cjk-final-probe.sh
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
